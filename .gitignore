# Ignore Rust/Cargo build artifacts
target/

# Ignore dependency directories
/target/

# Ignore generated binary artifacts
/*.rs.bk

# Ignore test results
/target/debug/.fingerprint/
/target/debug/build/
/target/debug/deps/
/target/debug/examples/

# Ignore release artifacts
/target/release/.fingerprint/
/target/release/build/
/target/release/deps/
/target/release/examples/

# Ignore documentation
/target/doc/

# Ignore editor and OS files
.DS_Store
.idea/
.vscode/

# Native C game build outputs (produced by .cursor/install.sh on Linux).
# These were previously committed as Windows/MinGW objects and a foreign
# prebuilt binary, which shadowed the local Linux build after checkout.
chaosforge-game/*.o
chaosforge-game/chaosforge

# Compiled binaries and object files (ensure these never get committed)
*.o
*.obj
*.lo
*.la
*.a
*.so
*.dylib
*.dll
*.exe
*.out
*.class
*.pyc
*.pyo
*.pyd
